{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://microsoft.example/csharp-to-rust/verification-result.schema.json",
  "title": "Verifier result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "agent",
    "verdict",
    "result_category",
    "summary",
    "input"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "agent": {
      "enum": [
        "syntax-style-verifier",
        "security-verifier",
        "end-to-end-verifier"
      ]
    },
    "verdict": {
      "enum": [
        "pass",
        "fail",
        "blocked"
      ]
    },
    "result_category": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "input": {
      "$ref": "#/$defs/input"
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "risk": {
      "enum": [
        "none",
        "low",
        "medium",
        "high",
        "critical",
        "unknown"
      ]
    },
    "environment": {
      "$ref": "#/$defs/environment"
    },
    "dependency_readiness": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dependency"
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/command"
      }
    },
    "tests": {
      "$ref": "#/$defs/tests"
    },
    "failures": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/failure"
      }
    },
    "evidence_validation": {
      "$ref": "#/$defs/evidenceValidation"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_root",
        "workspace_root",
        "code",
        "source_manifest",
        "source_sha256"
      ],
      "properties": {
        "artifact_root": {
          "type": "string",
          "minLength": 1
        },
        "workspace_root": {
          "type": "string",
          "minLength": 1
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "source_manifest": {
          "type": "string",
          "minLength": 1
        },
        "source_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "tool_validation_receipt": {
          "type": "string",
          "minLength": 1
        },
        "tool_validation_receipt_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "document": {
          "type": "string",
          "minLength": 1
        },
        "document_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "tests_manifest": {
          "type": "string",
          "minLength": 1
        },
        "tests_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "dependency_manifest": {
          "type": "string",
          "minLength": 1
        },
        "dependency_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "preflight_result": {
          "type": "string",
          "minLength": 1
        },
        "preflight_result_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "workspace_state_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "runtime_evidence_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "runtime_evidence": {
          "type": "string",
          "minLength": 1
        },
        "runtime_evidence_validation_receipt": {
          "type": "string",
          "minLength": 1
        },
        "runtime_evidence_validation_receipt_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "dependentRequired": {
        "tool_validation_receipt": [
          "tool_validation_receipt_sha256"
        ],
        "tool_validation_receipt_sha256": [
          "tool_validation_receipt"
        ],
        "runtime_evidence": [
          "runtime_evidence_sha256",
          "runtime_evidence_validation_receipt",
          "runtime_evidence_validation_receipt_sha256"
        ],
        "runtime_evidence_sha256": [
          "runtime_evidence",
          "runtime_evidence_validation_receipt",
          "runtime_evidence_validation_receipt_sha256"
        ],
        "runtime_evidence_validation_receipt": [
          "runtime_evidence",
          "runtime_evidence_sha256",
          "runtime_evidence_validation_receipt_sha256"
        ],
        "runtime_evidence_validation_receipt_sha256": [
          "runtime_evidence",
          "runtime_evidence_sha256",
          "runtime_evidence_validation_receipt"
        ]
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "status",
        "details"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "not_run"
          ]
        },
        "details": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "severity",
        "message"
      ],
      "properties": {
        "type": {
          "enum": [
            "syntax",
            "style",
            "security"
          ]
        },
        "severity": {
          "enum": [
            "warning",
            "error",
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "file": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "lines": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "rule": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "attack_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "impact": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "remediation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "confidence": {
          "const": "high"
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "machine",
        "attestation"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "machine": {
          "type": "string",
          "minLength": 1
        },
        "attestation": {
          "$ref": "#/$defs/sha256"
        },
        "toolchain": {
          "type": "string",
          "minLength": 1
        },
        "profile": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "strategy",
        "runtime_ready",
        "evidence"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "strategy": {
          "enum": [
            "rust-native",
            "generated",
            "bridge",
            "test-double",
            "unavailable"
          ]
        },
        "runtime_ready": {
          "type": "boolean"
        },
        "evidence": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "exit_code",
        "status",
        "evidence"
      ],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "exit_code": {
          "type": "integer"
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "not_run"
          ]
        },
        "evidence": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "passed",
        "failed",
        "skipped"
      ],
      "properties": {
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "test",
        "expected",
        "actual"
      ],
      "properties": {
        "test": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "requirement_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "expected": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "actual": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "evidenceValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signature_verified",
        "canonical_payload_matches",
        "all_blobs_verified",
        "execution_plan_verified",
        "exact_set_coverage_verified",
        "deterministic_status"
      ],
      "properties": {
        "signature_verified": {
          "const": true
        },
        "canonical_payload_matches": {
          "const": true
        },
        "all_blobs_verified": {
          "const": true
        },
        "execution_plan_verified": {
          "const": true
        },
        "exact_set_coverage_verified": {
          "const": true
        },
        "deterministic_status": {
          "enum": [
            "pass",
            "fail",
            "environment-blocked"
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "result_category": {
            "const": "passed"
          }
        },
        "required": [
          "result_category"
        ]
      },
      "then": {
        "properties": {
          "verdict": {
            "const": "pass"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "result_category": {
            "enum": [
              "violations-found",
              "vulnerabilities-found",
              "tests-failed"
            ]
          }
        },
        "required": [
          "result_category"
        ]
      },
      "then": {
        "properties": {
          "verdict": {
            "const": "fail"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "result_category": {
            "enum": [
              "invalid-input",
              "verification-blocked",
              "dependency-blocked",
              "environment-blocked"
            ]
          }
        },
        "required": [
          "result_category"
        ]
      },
      "then": {
        "properties": {
          "verdict": {
            "const": "blocked"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "agent": {
            "const": "syntax-style-verifier"
          }
        },
        "required": [
          "agent"
        ]
      },
      "then": {
        "required": [
          "checks",
          "findings"
        ],
        "properties": {
          "result_category": {
            "enum": [
              "passed",
              "violations-found",
              "invalid-input",
              "verification-blocked"
            ]
          },
          "risk": false,
          "environment": false,
          "dependency_readiness": false,
          "commands": false,
          "tests": false,
          "failures": false,
          "evidence_validation": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "agent": {
            "const": "syntax-style-verifier"
          },
          "verdict": {
            "const": "pass"
          }
        },
        "required": [
          "agent",
          "verdict"
        ]
      },
      "then": {
        "properties": {
          "input": {
            "required": [
              "tool_validation_receipt",
              "tool_validation_receipt_sha256"
            ]
          },
          "checks": {
            "minItems": 1,
            "items": {
              "allOf": [
                {
                  "$ref": "#/$defs/check"
                },
                {
                  "properties": {
                    "status": {
                      "const": "pass"
                    }
                  }
                }
              ]
            }
          },
          "findings": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "agent": {
            "const": "syntax-style-verifier"
          },
          "verdict": {
            "const": "fail"
          }
        },
        "required": [
          "agent",
          "verdict"
        ]
      },
      "then": {
        "properties": {
          "input": {
            "required": [
              "tool_validation_receipt",
              "tool_validation_receipt_sha256"
            ]
          }
        },
        "anyOf": [
          {
            "properties": {
              "checks": {
                "contains": {
                  "properties": {
                    "status": {
                      "const": "fail"
                    }
                  },
                  "required": [
                    "status"
                  ]
                }
              }
            }
          },
          {
            "properties": {
              "findings": {
                "minItems": 1
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "agent": {
            "const": "security-verifier"
          }
        },
        "required": [
          "agent"
        ]
      },
      "then": {
        "required": [
          "checks",
          "findings",
          "risk"
        ],
        "properties": {
          "result_category": {
            "enum": [
              "passed",
              "vulnerabilities-found",
              "invalid-input",
              "verification-blocked"
            ]
          },
          "environment": false,
          "dependency_readiness": false,
          "commands": false,
          "tests": false,
          "failures": false,
          "evidence_validation": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "agent": {
            "const": "security-verifier"
          },
          "verdict": {
            "const": "pass"
          }
        },
        "required": [
          "agent",
          "verdict"
        ]
      },
      "then": {
        "properties": {
          "risk": {
            "const": "none"
          },
          "checks": {
            "minItems": 1,
            "items": {
              "allOf": [
                {
                  "$ref": "#/$defs/check"
                },
                {
                  "properties": {
                    "status": {
                      "const": "pass"
                    }
                  }
                }
              ]
            }
          },
          "findings": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "agent": {
            "const": "security-verifier"
          },
          "verdict": {
            "const": "fail"
          }
        },
        "required": [
          "agent",
          "verdict"
        ]
      },
      "then": {
        "properties": {
          "risk": {
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "findings": {
            "minItems": 1,
            "items": {
              "allOf": [
                {
                  "$ref": "#/$defs/finding"
                },
                {
                  "required": [
                    "attack_path",
                    "impact",
                    "remediation",
                    "confidence"
                  ],
                  "properties": {
                    "type": {
                      "const": "security"
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "agent": {
            "const": "end-to-end-verifier"
          }
        },
        "required": [
          "agent"
        ]
      },
      "then": {
        "properties": {
          "result_category": {
            "enum": [
              "passed",
              "tests-failed",
              "invalid-input",
              "dependency-blocked",
              "environment-blocked",
              "verification-blocked"
            ]
          },
          "checks": false,
          "findings": false,
          "risk": false,
          "input": {
            "required": [
              "document",
              "document_sha256",
              "tests_manifest",
              "tests_manifest_sha256",
              "dependency_manifest",
              "dependency_manifest_sha256",
              "preflight_result",
              "preflight_result_sha256"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "agent": {
            "const": "end-to-end-verifier"
          },
          "result_category": {
            "enum": [
              "passed",
              "tests-failed",
              "environment-blocked"
            ]
          }
        },
        "required": [
          "agent",
          "result_category"
        ]
      },
      "then": {
        "required": [
          "environment",
          "dependency_readiness",
          "commands",
          "tests",
          "failures",
          "evidence_validation"
        ],
        "properties": {
          "input": {
            "required": [
              "workspace_state_sha256",
              "runtime_evidence",
              "runtime_evidence_sha256",
              "runtime_evidence_validation_receipt",
              "runtime_evidence_validation_receipt_sha256"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "agent": {
            "const": "end-to-end-verifier"
          },
          "verdict": {
            "const": "pass"
          }
        },
        "required": [
          "agent",
          "verdict"
        ]
      },
      "then": {
        "properties": {
          "dependency_readiness": {
            "minItems": 1,
            "items": {
              "allOf": [
                {
                  "$ref": "#/$defs/dependency"
                },
                {
                  "properties": {
                    "strategy": {
                      "enum": [
                        "rust-native",
                        "generated",
                        "bridge"
                      ]
                    },
                    "runtime_ready": {
                      "const": true
                    }
                  }
                }
              ]
            }
          },
          "commands": {
            "minItems": 1,
            "items": {
              "allOf": [
                {
                  "$ref": "#/$defs/command"
                },
                {
                  "properties": {
                    "exit_code": {
                      "const": 0
                    },
                    "status": {
                      "const": "pass"
                    }
                  }
                }
              ]
            }
          },
          "tests": {
            "properties": {
              "passed": {
                "minimum": 1
              },
              "failed": {
                "const": 0
              },
              "skipped": {
                "const": 0
              }
            }
          },
          "failures": {
            "maxItems": 0
          },
          "evidence_validation": {
            "properties": {
              "deterministic_status": {
                "const": "pass"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "agent": {
            "const": "end-to-end-verifier"
          },
          "result_category": {
            "const": "tests-failed"
          }
        },
        "required": [
          "agent",
          "result_category"
        ]
      },
      "then": {
        "properties": {
          "evidence_validation": {
            "properties": {
              "deterministic_status": {
                "const": "fail"
              }
            }
          }
        },
        "anyOf": [
          {
            "properties": {
              "commands": {
                "contains": {
                  "properties": {
                    "status": {
                      "const": "fail"
                    }
                  },
                  "required": [
                    "status"
                  ]
                }
              }
            }
          },
          {
            "properties": {
              "tests": {
                "properties": {
                  "failed": {
                    "minimum": 1
                  }
                }
              }
            }
          },
          {
            "properties": {
              "failures": {
                "minItems": 1
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "agent": {
            "const": "end-to-end-verifier"
          },
          "result_category": {
            "const": "dependency-blocked"
          }
        },
        "required": [
          "agent",
          "result_category"
        ]
      },
      "then": {
        "required": [
          "environment",
          "dependency_readiness"
        ],
        "properties": {
          "dependency_readiness": {
            "contains": {
              "properties": {
                "runtime_ready": {
                  "const": false
                }
              },
              "required": [
                "runtime_ready"
              ]
            }
          },
          "commands": false,
          "tests": false,
          "failures": false,
          "evidence_validation": false
        }
      }
    }
  ]
}
