{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://microsoft.example/csharp-to-rust/runtime-evidence-validation.schema.json",
  "title": "Authenticated deterministic runtime evidence validation receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "validation",
    "validation_authentication",
    "validation_payload_canonical",
    "validation_payload"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "validation": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "validation_authentication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "key_id",
        "canonicalization",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "HMAC-SHA256"
        },
        "key_id": {
          "type": "string",
          "minLength": 1
        },
        "canonicalization": {
          "const": "sorted-json-integer-v1"
        },
        "value": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]{43}=$"
        }
      }
    },
    "validation_payload_canonical": {
      "type": "string",
      "minLength": 2
    },
    "validation_payload": {
      "$ref": "#/$defs/payload"
    }
  },
  "$defs": {
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "run_id",
        "validator_id",
        "validator_version",
        "runtime_evidence_sha256",
        "source_sha256",
        "preflight_attestation",
        "execution_plan_sha256",
        "signature_verified",
        "canonical_payload_matches",
        "all_blobs_verified",
        "execution_plan_verified",
        "exact_set_coverage_verified",
        "deterministic_status"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "validator_id": {
          "type": "string",
          "minLength": 1
        },
        "validator_version": {
          "type": "string",
          "minLength": 1
        },
        "runtime_evidence_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "preflight_attestation": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "execution_plan_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "signature_verified": {
          "const": true
        },
        "canonical_payload_matches": {
          "const": true
        },
        "all_blobs_verified": {
          "const": true
        },
        "execution_plan_verified": {
          "const": true
        },
        "exact_set_coverage_verified": {
          "const": true
        },
        "deterministic_status": {
          "enum": [
            "pass",
            "fail",
            "environment-blocked"
          ]
        }
      }
    }
  }
}
