{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://microsoft.example/csharp-to-rust/source-manifest.schema.json",
  "title": "Immutable verifier source manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "canonicalization",
    "code",
    "exclusion_policy",
    "files"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "canonicalization": {
      "const": "sorted-json-integer-v1"
    },
    "code": {
      "$ref": "#/$defs/relativePath"
    },
    "exclusion_policy": {
      "const": "generated-output-v1"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "$ref": "#/$defs/relativePath"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:\\.|[^<>:\"/|?*\\u0000-\\u001f\\u007f\\\\]*[^<>:\"/|?*\\u0000-\\u001f\\u007f\\\\. ](?:\\\\[^<>:\"/|?*\\u0000-\\u001f\\u007f\\\\]*[^<>:\"/|?*\\u0000-\\u001f\\u007f\\\\. ])*)$",
      "not": {
        "pattern": "(^|\\\\)\\.\\.(\\\\|$)"
      }
    }
  }
}
