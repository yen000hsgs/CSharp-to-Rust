{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://microsoft.example/csharp-to-rust/source-manifest.schema.json",
  "title": "Immutable verifier source manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "canonicalization",
    "workspace_root",
    "code",
    "files"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "canonicalization": {
      "const": "sorted-json-integer-v1"
    },
    "workspace_root": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![\\s\\S]*[\\u0000-\\u001f\\u007f])[A-Za-z]:\\\\(?:[A-Za-z0-9_ .@()+-]+\\\\?)+$"
    },
    "code": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![\\s\\S]*[\\u0000-\\u001f\\u007f])(?!.*(?:^|\\\\)\\.\\.(?:\\\\|$))[A-Za-z0-9_ .@()+-]+(?:\\\\[A-Za-z0-9_ .@()+-]+)*$"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?![\\s\\S]*[\\u0000-\\u001f\\u007f])(?!.*(?:^|\\\\)\\.\\.(?:\\\\|$))[A-Za-z0-9_ .@()+-]+(?:\\\\[A-Za-z0-9_ .@()+-]+)*$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
